{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "shippedAt": {
      "type": "string",
      "format": "date-time"
    },
    "customerEmail": {
      "type": "string",
      "format": "email"
    },
    "totalCents": {
      "type": "integer"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "shippedAt", "customerEmail", "totalCents", "createdAt"]
}
