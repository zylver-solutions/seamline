{
  "name": "@seamline/mcp",
  "version": "0.1.0",
  "description": "The Seamline MCP server: serves graph context to AI coding agents over stdio through parameterized tools.",
  "keywords": [
    "seamline",
    "static-analysis",
    "code-graph",
    "mcp"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Zylver Solutions",
    "email": "seamline@zylver.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zylver-solutions/seamline.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/zylver-solutions/seamline/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/zylver-solutions/seamline/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__fixtures__/**",
    "!dist/**/*.map",
    "!dist/testing.*",
    "README.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@seamline/ontology": "workspace:*",
    "@seamline/core": "workspace:*",
    "@seamline/security": "workspace:*"
  },
  "bin": {
    "seamline-mcp": "./dist/bin.js"
  }
}
