{
  "format": "seamline-corpus/1",
  "kind": "secrets",
  "description": "Credential-shaped strings for the Seamline redactor, none of them live. Each value is split into parts so that no credential appears contiguously in this file. To add a case, see packages/security/README.md.",
  "entries": [
    {
      "id": "private-key-pem/canary-body",
      "category": "secret",
      "rule": "private-key-pem",
      "surface": "free-text",
      "expect": "redacted",
      "fakeBecause": "the base64 body is the word CANARY repeated; it does not decode to any key structure",
      "template": ["deploy key:\n{{secret}}\n"],
      "secret": [
        "-----BEGIN RSA PRI",
        "VATE KEY-----\n",
        "CANARYCANARYCANARYCANARY0001\n",
        "CANARYCANARYCANARYCANARY0002\n",
        "-----END RSA PRI",
        "VATE KEY-----"
      ]
    },
    {
      "id": "private-key-pem/in-file-path",
      "category": "secret",
      "rule": "private-key-pem",
      "surface": "identity",
      "expect": "refused",
      "fakeBecause": "the base64 body is the word CANARY repeated; it does not decode to any key structure",
      "template": ["config/{{secret}}.json"],
      "secret": [
        "-----BEGIN RSA PRI",
        "VATE KEY-----\n",
        "CANARYCANARYCANARYCANARY0001\n",
        "CANARYCANARYCANARYCANARY0002\n",
        "-----END RSA PRI",
        "VATE KEY-----"
      ]
    },
    {
      "id": "age-secret-key/canary-body",
      "category": "secret",
      "rule": "age-secret-key",
      "surface": "free-text",
      "expect": "redacted",
      "fakeBecause": "the data part is the word CANARY repeated and carries no valid bech32 checksum",
      "template": ["sops key {{secret}} in the runner"],
      "secret": [
        "AGE-SECRET",
        "-KEY-1",
        "CANARYCANARYCANARYCANARYCANARY",
        "CANARYCANARYCANARYCANARYCANARY"
      ]
    },
    {
      "id": "age-secret-key/in-file-path",
      "category": "secret",
      "rule": "age-secret-key",
      "surface": "identity",
      "expect": "refused",
      "fakeBecause": "the data part is the word CANARY repeated and carries no valid bech32 checksum",
      "template": ["config/{{secret}}.json"],
      "secret": [
        "AGE-SECRET",
        "-KEY-1",
        "CANARYCANARYCANARYCANARYCANARY",
        "CANARYCANARYCANARYCANARYCANARY"
      ]
    },
    {
      "id": "aws-access-key-id/documented-example",
      "category": "secret",
      "rule": "aws-access-key-id",
      "surface": "free-text",
      "expect": "redacted",
      "fakeBecause": "AWS's own documentation example key id; it is published as an example and belongs to no account",
      "template": ["const accessKeyId = {{secret}};"],
      "secret": ["AKIA", "IOSFODNN7EXAMPLE"]
    },
    {
      "id": "aws-access-key-id/in-file-path",
      "category": "secret",
      "rule": "aws-access-key-id",
      "surface": "identity",
      "expect": "refused",
      "fakeBecause": "AWS's own documentation example key id; it is published as an example and belongs to no account",
      "template": ["config/{{secret}}.json"],
      "secret": ["AKIA", "IOSFODNN7EXAMPLE"]
    },
    {
      "id": "aws-access-key-id/session-prefix",
      "category": "secret",
      "rule": "aws-access-key-id",
      "surface": "free-text",
      "expect": "redacted",
      "fakeBecause": "sixteen characters of the word CANARY and a digit after the ASIA prefix; not issued by any account",
      "template": ["AWS_SESSION_KEY_ID is {{secret}} for the build role"],
      "secret": ["AS", "IA", "CANARYCANARYCAN0"]
    },
    {
      "id": "aws-secret-access-key/documented-example",
      "category": "secret",
      "rule": "aws-secret-access-key",
      "surface": "free-text",
      "expect": "redacted",
      "fakeBecause": "AWS's own documentation example secret access key; it is published as an example and belongs to no account",
      "template": ["aws_secret_access_key = \"{{secret}}\""],
      "secret": ["wJalrXUtnFEMI/K7M", "DENG/bPxRfiCYEXAMPLEKEY"]
    },
    {
      "id": "github-token/invalid-checksum",
      "category": "secret",
      "rule": "github-token",
      "surface": "free-text",
      "expect": "redacted",
      "fakeBecause": "thirty characters of CANARY plus the six-character suffix CANARY; the real suffix is a base62 CRC32 of the first thirty, which for this body is 2vUQNx",
      "template": ["GH auth header uses {{secret}} for CI"],
      "secret": ["gh", "p_", "CANARYCANARYCANARYCANARYCANARY", "CANARY"]
    },
    {
      "id": "github-token/in-file-path",
      "category": "secret",
      "rule": "github-token",
      "surface": "identity",
      "expect": "refused",
      "fakeBecause": "thirty characters of CANARY plus the six-character suffix CANARY; the real suffix is a base62 CRC32 of the first thirty, which for this body is 2vUQNx",
      "template": ["config/{{secret}}.json"],
      "secret": ["gh", "p_", "CANARYCANARYCANARYCANARYCANARY", "CANARY"]
    },
    {
      "id": "github-fine-grained-pat/canary-body",
      "category": "secret",
      "rule": "github-fine-grained-pat",
      "surface": "free-text",
      "expect": "redacted",
      "fakeBecause": "the identifier parts are the word CANARY and zeros; no such token was ever issued",
      "template": ["token {{secret}}"],
      "secret": ["github", "_pat_11CANARY00", "_CANARYCANARYCANARY", "CANARYCANARYCANARYCANARY"]
    },
    {
      "id": "github-fine-grained-pat/in-file-path",
