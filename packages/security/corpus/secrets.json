    {
      "id": "connection-string-password/invented-password",
      "category": "secret",
      "rule": "connection-string-password",
      "surface": "free-text",
      "expect": "redacted",
      "fakeBecause": "an invented password on a reserved .invalid host (RFC 2606); the host cannot resolve",
      "template": [
        "DATABASE_URL=postgres://appuser:{{secret}}@db.example.invalid:5432/appdb?sslmode=require"
      ],
      "secret": ["Canary-Pass", "word-0000"]
    },
    {
      "id": "bearer-header/canary-token",
      "category": "secret",
      "rule": "bearer-header",
      "surface": "free-text",
      "expect": "redacted",
      "fakeBecause": "the token is the word CANARY repeated; no service issued it",
      "template": ["Authorization: Bearer {{secret}}"],
      "secret": ["CANARYBEARER", "000011112222"]
    },
    {
      "id": "basic-auth-header/canary-credentials",
